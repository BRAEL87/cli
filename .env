# Nova Agent CLI - Environment Variables
# Copy this to .env and fill in your values

# --- OpenRouter (recommended) ---
NOVA_API_KEY=your-openrouter-api-key
NOVA_API_BASE=https://openrouter.ai/api/v1

# --- Direct OpenAI ---
# NOVA_API_KEY=sk-your-openai-key
# NOVA_API_BASE=https://api.openai.com/v1

# --- Nova backend (local dev) ---
# NOVA_API_KEY=your-nova-api-key
# NOVA_API_BASE=http://localhost:5000/api
