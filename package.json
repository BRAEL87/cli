{
  "name": "nova-agent-cli",
  "version": "1.0.2",
  "description": "Nova AI coding agent — interactive CLI like Claude Code, powered by free Hy3 model",
  "author": "Nova Studio",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/nova-studio/nova-agent-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-studio/nova-agent-cli.git"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "cli",
    "autonomous",
    "openrouter",
    "hy3",
    "llm"
  ],
  "main": "dist/nova-agent.js",
  "bin": {
    "nova": "./dist/nova-repl.js",
    "nova-agent": "./dist/nova-agent.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx nova-repl.ts",
    "start": "tsx nova-repl.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "axios": "^1.6.7",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^17.3.1",
    "ora": "^8.0.1",
    "simple-git": "^3.32.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
