# Nova Agent CLI - Environment Variables
# Copy this to .env and fill in your values

# --- OpenRouter (default, free models available) ---
NOVA_API_KEY=sk-or-v1-your-openrouter-key-here
NOVA_API_BASE=https://openrouter.ai/api/v1

# --- Direct OpenAI (paid) ---
# NOVA_API_KEY=sk-your-openai-key
# NOVA_API_BASE=https://api.openai.com/v1

# --- Nova backend (local dev, requires server running) ---
# NOVA_API_KEY=your-nova-api-key
# NOVA_API_BASE=http://localhost:5000/api

# Recommended models:
# - tencent/hy3-preview:free (BEST FREE MODEL - 74.4% on SWE-bench!)
# - openai/gpt-4o-mini (cheap & reliable, ~$0.15/1M tokens)
# - anthropic/claude-3.5-sonnet (best quality, ~$3/1M tokens)
# - google/gemini-flash-1.5 (fast & cheap, ~$0.075/1M tokens)
#
# Free models (no credits needed):
# - tencent/hy3-preview:free (RECOMMENDED - strong coding performance)
# - openrouter/free (auto-selects available free model)
# - google/gemini-2.0-flash-thinking-exp:free
# - meta-llama/llama-3.3-70b-instruct:free
# - qwen/qwen-2.5-coder-32b-instruct:free
# - nvidia/llama-3.1-nemotron-70b-instruct:free
#
# Note: Hy3 Preview is the best free model for coding tasks
